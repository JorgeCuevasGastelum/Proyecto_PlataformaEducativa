# Copia este archivo a .env; cada integrante configura SU MySQL local.
# Instala MySQL Server: Workbench es el cliente y no reemplaza al servidor.
# Codifica los caracteres especiales de la contraseña como parte de una URL.
DATABASE_URL="mysql://root:CAMBIA_TU_PASSWORD@127.0.0.1:3306/plataforma_educativa"
PORT=3000
# Lista exacta de orígenes de los futuros clientes, separados por coma.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"
# Genera un secreto propio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_48_BYTES"
JWT_TTL_SECONDS=3600
SEED_ADMIN_EMAIL="diana@admin.edu.mx"
# El seed usa esta contraseña local para las cuentas demostrativas; nunca la publica.
SEED_PASSWORD="REEMPLAZA_CON_UNA_CONTRASENA_DE_PRUEBA"
# Opcional: base EXCLUSIVA para pruebas; debe terminar en _test.
# TEST_DATABASE_URL="mysql://root:CAMBIA_TU_PASSWORD@127.0.0.1:3306/plataforma_educativa_test"
